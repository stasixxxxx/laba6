  <diagram name="Страница-1" id="9VLBPsR3gVNRncThDACS">
    <mxGraphModel dx="2359" dy="1448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Настройка внешнего вида блоков по ГОСТу\n    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px,rx:20px,ry:20px;\n    classDef process fill:#fff,stroke:#333,stroke-width:2px;\n    classDef io fill:#fff,stroke:#333,stroke-width:2px,shape:parallelogram;\n    classDef condition fill:#fff,stroke:#333,stroke-width:2px,shape:diamond;\n\n    %% ==========================================\n    %% ЦЕНТРАЛЬНАЯ СТРОКА: ГЛАВНЫЙ АЛГОРИТМ (MAIN)\n    %% ==========================================\n    START([Начало программы]) --&gt; INIT[\&quot;setlocale(LC_ALL, &#39;RUS&#39;)\&quot;]\n    INIT --&gt; CALL_TASK1{\&quot;Вызов task1()\&quot;}\n    CALL_TASK1 --&gt; CALL_TASK2{\&quot;Вызов task2()\&quot;}\n    CALL_TASK2 --&gt; CALL_TASK3{\&quot;Вызов task3()\&quot;}\n    CALL_TASK3 --&gt; END([Конец программы])\n\n    %% ==========================================\n    %% ЛЕВАЯ СТОРОНА: ЗАДАЧА 1 И ЗАДАЧА 2\n    %% ==========================================\n    \n    %% Задача 1 (Уходит влево вверх)\n    CALL_TASK1 -.-&gt; T1_PR[/Вывод: &#39;Введите год&#39;/]\n    T1_PR --&gt; T1_SC[/Ввод: years/]\n    T1_SC --&gt; T1_COND{\&quot;years % 4 == 0...\&quot;}\n    T1_COND -- Да --&gt; T1_T[/Вывод: високосный/] --&gt; T1_P[\&quot;system(&#39;pause&#39;)\&quot;]\n    T1_COND -- Нет --&gt; T1_F[/Вывод: не високосный/] --&gt; T1_P\n\n    %% Задача 2 (Уходит влево вниз)\n    CALL_TASK2 -.-&gt; T2_PR[/Вывод: &#39;Введите x&#39;/]\n    T2_PR --&gt; T2_SC[/Ввод: x/]\n    T2_SC --&gt; T2_COND{\&quot;x &gt;= 8\&quot;}\n    T2_COND -- Да --&gt; T2_T[\&quot;F(x) = -x*x + x - 9\&quot;] --&gt; T2_OUT[/Вывод: F(x)/]\n    T2_COND -- Нет --&gt; T2_F[\&quot;F(x) = 1 / ...\&quot;] --&gt; T2_OUT\n    T2_OUT --&gt; T2_P[\&quot;system(&#39;pause&#39;)\&quot;]\n\n    %% ==========================================\n    %% ПРАВАЯ СТОРОНА: ЗАДАЧА 3 (САМАЯ БОЛЬШАЯ)\n    %% ==========================================\n    CALL_TASK3 -.-&gt; T3_PR[/Вывод: &#39;Введите число&#39;/]\n    T3_PR --&gt; T3_SC[/Ввод: num/]\n    T3_SC --&gt; T3_CALC[\&quot;Разбиение на h, t, u&lt;br&gt;has_matches = 0\&quot;]\n    \n    T3_CALC --&gt; T3_C1{\&quot;u == t\&quot;}\n    T3_C1 -- Да --&gt; T3_S1[\&quot;has_matches = 1\&quot;] --&gt; T3_C2{\&quot;h == t\&quot;}\n    T3_C1 -- Нет --&gt; T3_C2\n    \n    T3_C2 -- Да --&gt; T3_S2[\&quot;has_matches = 1\&quot;] --&gt; T3_C3{\&quot;h == u\&quot;}\n    T3_C2 -- Нет --&gt; T3_C3\n    \n    T3_C3 -- Да --&gt; T3_S3[\&quot;has_matches = 1\&quot;] --&gt; T3_CF{\&quot;!has_matches\&quot;}\n    T3_C3 -- Нет --&gt; T3_CF\n    \n    T3_CF -- Да --&gt; T3_NONE[/Вывод: совпадений нет/] --&gt; T3_P[\&quot;system(&#39;pause&#39;)\&quot;]\n    T3_CF -- Нет --&gt; T3_P\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="q5KrjJt2mLAYXdEfGAY1-423">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
